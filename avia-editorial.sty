% Nota de margen: bloque corto. Si no cabe, detener, no recortar silenciosamente.
\newsavebox{\AviaMarginBox}
\long\def\AviaPutMargin#1{%
  \ifAviaInBox\PackageError{avia-editorial}{AVIA-E-MARGIN-CONTEXT: margin in a box}{Use a footnote or text inside that box.}\fi
  \ifinner
    \PackageError{avia-editorial}{AVIA-E-MARGIN-CONTEXT: margin in a box}{Use a footnote or text inside that box.}%
  \fi
  \sbox{\AviaMarginBox}{\begin{minipage}[t]{\marginparwidth}\vspace{0pt}
    \footnotesize\raggedright\color{AviaMuted}#1\end{minipage}}%
  \ifdim\dimexpr\ht\AviaMarginBox+\dp\AviaMarginBox\relax>.48\textheight
    \PackageError{avia-editorial}{AVIA-E-MARGIN-HEIGHT: margin item too tall}{Use a footnote or a figure in the text column.}%
  \fi
  \marginpar{\usebox{\AviaMarginBox}}%
}
\newcommand{\sidenote}[1]{\ifAviaIllustrated\AviaPutMargin{#1}\else\footnote{#1}\fi}
\newcommand{\margintext}[1]{\sidenote{#1}}
\newcommand{\sidecite}[2][]{\sidenote{\iflanguage{spanish}{Fuente}{Source}: #2\ifblank{#1}{}{; \emph{#1}}}}
% Extensión exterior de una sola página. Se recoge antes de colocarla;
% el espacio se reserva ANTES de comprobar paridad. La etiqueta se escribe
% al enviar la página, por lo que también sirve para flotantes aplazados.
\newsavebox{\AviaWideBox}
\newlength{\AviaWideExtra}
\newlength{\AviaBlockHeight}
\newif\ifAviaInFullwidth
\NewDocumentEnvironment{fullwidth}{+b}{%
  \par\begingroup
  \ifAviaInFullwidth\PackageError{avia-editorial}{AVIA-E-NESTED-WIDE: nested fullwidth}{Do not nest fullwidth environments.}\fi
  \AviaInFullwidthtrue
  \ifdim\linewidth<\textwidth
    \PackageError{avia-editorial}{AVIA-E-WIDE-CONTEXT: fullwidth in narrow container}{Place the block at the main column level.}%
  \fi
  \setlength{\AviaWideExtra}{\dimexpr\marginparsep+\marginparwidth\relax}%
  \sbox{\AviaWideBox}{\begin{minipage}{\dimexpr\linewidth+\AviaWideExtra\relax}#1\end{minipage}}%
  \setlength{\AviaBlockHeight}{\dimexpr\ht\AviaWideBox+\dp\AviaWideBox\relax}%
  \ifdim\AviaBlockHeight>\dimexpr\textheight-4pt\relax
    \PackageError{avia-editorial}{AVIA-E-WIDE-HEIGHT: fullwidth exceeds one page}{Split it into blocks; use a normal breakable box for long text.}%
  \fi
  \ifinner\else\Needspace{\dimexpr\AviaBlockHeight+\baselineskip\relax}\fi
  \noindent\checkoddpage
  \if@twoside
    \ifoddpage\makebox[\linewidth][l]{\usebox{\AviaWideBox}}%
    \else\makebox[\linewidth][r]{\usebox{\AviaWideBox}}\fi
  \else\makebox[\linewidth][l]{\usebox{\AviaWideBox}}\fi
  \par\endgroup
}{}
% Imagen y pie se miden por separado; la altura disponible incluye el pie.
\newsavebox{\AviaCaptionBox}
\newlength{\AviaImageHeight}
\newlength{\AviaImageWidth}
\newcommand{\AviaRenderFigure}[4]{%
  \setlength{\AviaImageWidth}{#1}%
  \ifdim\AviaImageWidth>\linewidth
    \PackageError{avia-editorial}{AVIA-E-IMAGE-WIDTH: width exceeds container}{Choose a width no greater than linewidth.}%
  \fi
  \ifdim\AviaImageWidth<1pt
    \PackageError{avia-editorial}{AVIA-E-IMAGE-WIDTH: nonpositive width}{Choose a positive width.}%
  \fi
  % Check wrapped caption height before memoir's one-line measurement.
  \sbox{\AviaCaptionBox}{\begin{minipage}{\linewidth}\small\raggedright
    \renewcommand{\footnote}[1]{\PackageError{avia-editorial}{AVIA-E-CAPTION-NOTE: footnote in caption}{Put the note in the body text.}}
    #3\par\end{minipage}}%
  \ifdim\dimexpr\ht\AviaCaptionBox+\dp\AviaCaptionBox\relax>.8\textheight
    \PackageError{avia-editorial}{AVIA-E-CAPTION-HEIGHT: caption too long}{Move the explanation into the body.}%
  \fi
  \sbox{\AviaCaptionBox}{\begin{minipage}{\linewidth}\caption{#3}\ifblank{#4}{}{\label{#4}}\end{minipage}}%
  \setlength{\AviaImageHeight}{\dimexpr\textheight-\ht\AviaCaptionBox-\dp\AviaCaptionBox-2\baselineskip\relax}%
  \ifdim\AviaImageHeight<3\baselineskip
    \PackageError{avia-editorial}{AVIA-E-CAPTION-HEIGHT: caption leaves no image space}{Shorten the caption; move explanation into the body.}%
  \fi
  \centering\includegraphics[width=\AviaImageWidth,height=\AviaImageHeight,keepaspectratio]{#2}\par
  \nointerlineskip\usebox{\AviaCaptionBox}\par
}
\NewDocumentCommand{\widefigure}{O{\linewidth} m m O{}}{%
  \begin{figure}[htbp]\AviaRenderFigure{#1}{#2}{#3}{#4}\end{figure}}
\NewDocumentCommand{\fullwidthfigure}{m m O{}}{%
  \begin{figure}[htbp]\begin{fullwidth}\AviaRenderFigure{\linewidth}{#1}{#2}{#3}\end{fullwidth}\end{figure}}
\NewDocumentCommand{\aviamarginfigure}{O{.97\marginparwidth} m m}{%
  \ifAviaIllustrated
    \setlength{\AviaImageWidth}{#1}%
    \ifdim\AviaImageWidth>\marginparwidth\PackageError{avia-editorial}{AVIA-E-IMAGE-WIDTH: margin image too wide}{Use a width within marginparwidth.}\fi
    \ifdim\AviaImageWidth<1pt\PackageError{avia-editorial}{AVIA-E-IMAGE-WIDTH: nonpositive margin image}{Use a positive width.}\fi
    \AviaPutMargin{\centering\includegraphics[width=#1,height=.28\textheight,keepaspectratio]{#2}\par\smallskip\raggedright #3}%
  \else\widefigure[.65\linewidth]{#2}{#3}\fi}
\newcommand{\chapterquote}[2]{%
